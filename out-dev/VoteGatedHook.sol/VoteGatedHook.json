internalType\":\"bytes\",\"name\":\"newSvgInline\",\"type\":\"bytes\"},{\"internalType\":\"bytes32\",\"name\":\"newStateHash\",\"type\":\"bytes32\"},{\"internalType\":\"bool\",\"name\":\"requiresKeeper\",\"type\":\"bool\"}],\"internalType\":\"struct EvolutionTypes.EvolutionResult\",\"name\":\"r\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"permissions\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"agentId\",\"type\":\"uint256\"},{\"internalType\":\"uint8\",\"name\":\"newStage\",\"type\":\"uint8\"}],\"name\":\"setStage\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"stage\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vimsAttest\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vimsProvenance\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"author\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"repo\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"license\",\"type\":\"bytes32\"},{\"internalType\":\"string\",\"name\":\"version\",\"type\":\"string\"},{\"internalType\":\"string\",\"name\":\"contractName\",\"type\":\"string\"},{\"internalType\":\"bytes32\",\"name\":\"magic\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Permission set: FLAG_ON_TRIGGER. Trigger handled: TRIGGER_CUSTOM         (kind == keccak256(\\\"vote.gated\\\")). The hook holds no funds and         declares no transfer permissions, so a stuck governor cannot         soft-rug holders.\",\"kind\":\"dev\",\"methods\":{\"vimsProvenance()\":{\"returns\":{\"author\":\"     keccak256 of canonical author identity (Layer 2)\",\"contractName\":\"canonical name of this contract (Layer 3 input)\",\"license\":\"    keccak256 of license string (Layer 2)\",\"magic\":\"      steganographic magic baked in deployment bytecode (Layer 3)\",\"repo\":\"       keccak256 of canonical source repository (Layer 2)\",\"version\":\"    human-readable protocol version (Layer 2)\"}}},\"title\":\"VoteGatedHook\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"VIMS_AUTHOR()\":{\"notice\":\"keccak256(\\\"vims.protocol.arqonai\\\") \\u2014 canonical author identity.\"},\"VIMS_LICENSE()\":{\"notice\":\"keccak256(\\\"MIT\\\") \\u2014 license under which this code is published.\"},\"VIMS_REPO()\":{\"notice\":\"keccak256(\\\"github.com/arqonai/vimsbot-contracts\\\") \\u2014 canonical source repo.\"},\"VIMS_VERSION()\":{\"notice\":\"Human-readable protocol version.\"},\"getPermissions()\":{\"notice\":\"Subclasses override to declare lifecycle support.\"},\"hookInterfaceId()\":{\"notice\":\"ERC-165 family identifier for hook discovery.         keccak256(\\\"IAgentEvolutionHook(uint256)\\\") truncated to bytes4.\"},\"permissions()\":{\"notice\":\"Bitset of {EvolutionTypes.FLAG_*} declaring which lifecycle hooks         this contract supports. Hosts MUST honor it: callbacks whose flag         is unset MUST NOT be invoked.\"},\"setStage(uint256,uint8)\":{\"notice\":\"Governance-only call to push an agent to a new stage. Must         strictly exceed the current stage and never exceed `maxStage`.\"},\"stage(uint256)\":{\"notice\":\"Current visual stage per agent. Monotonically non-decreasing.\"},\"vimsAttest()\":{\"notice\":\"Pure attestation function that defeats dead-code elimination on         the steganographic constants. Anyone (off-chain) can call this         to verify the bytecode they hold matches a canonical VIMS build.\"},\"vimsProvenance()\":{\"notice\":\"Returns the full VIMS provenance block for this contract.\"}},\"notice\":\"Renders an SVG that advances through governance-approved stages.         A configurable `governor` address is the only entity that may         advance the stage (typically the executor of an OZ Governor or a         multisig). Anyone may then call `triggerEvolve(id, TRIGGER_CUSTOM, \\\"\\\")`         to redraw with the current stage.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/hooks/VoteGatedHook.sol\":\"VoteGatedHook\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":ds-test/=lib/openzeppelin-contracts/lib/forge-std/lib/ds-test/src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":openzeppelin-contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/\",\":openzeppelin-contracts/=lib/openzeppelin-contracts/\"],\"viaIR\":true},\"sources\":{\"src/VimsProvenance.sol\":{\"keccak256\":\"0xc2c73951ac5bd647c3c4da11a026c69a3eb03930d38eb8938aa5b59a28d2e50d\",\"license\":\"AGPL-3.0-or-later\",\"urls\":[\"bzz-raw://6be2f39676b8301210f0616373239f9be8f5e486c8c54066a3c301fa52aabb2c\",\"dweb:/ipfs/QmXqPXKigSRoYdyeMHbsyu4hJYVPT9GushimjDcYvm9D54\"]},\"src/hooks/BaseEvolutionHook.sol\":{\"keccak256\":\"0x7a36031dfe0d4c86419bd59e889b9d48b6adc92deb2300559985e1b36a697a13\",\"license\":\"AGPL-3.0-or-later\",\"urls\":[\"bzz-raw://7afef647b1d6349b07706cee51026b823b82835ba024012a129b1f2c84aaba67\",\"dweb:/ipfs/QmPrkK2B2XZMsXYbjAixBTjBx3W2hJ7CSdHRxu9mqAWSY6\"]},\"src/hooks/EvolutionTypes.sol\":{\"keccak256\":\"0x5cbd2d40db770afb8046a000dc1172ebf9a08db4fbc0e957f52791e2c6fa8c63\",\"license\":\"AGPL-3.0-or-later\",\"urls\