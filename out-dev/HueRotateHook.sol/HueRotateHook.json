,{\"inputs\":[],\"name\":\"secondsPerStep\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vimsAttest\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vimsProvenance\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"author\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"repo\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"license\",\"type\":\"bytes32\"},{\"internalType\":\"string\",\"name\":\"version\",\"type\":\"string\"},{\"internalType\":\"string\",\"name\":\"contractName\",\"type\":\"string\"},{\"internalType\":\"bytes32\",\"name\":\"magic\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Permission set: FLAG_ON_TRIGGER. Trigger handled: TRIGGER_TIME_TICK.         Stateless across agents \\u2014 the rendered hue is purely a function of         block.timestamp and the immutable stride.\",\"kind\":\"dev\",\"methods\":{\"vimsProvenance()\":{\"returns\":{\"author\":\"     keccak256 of canonical author identity (Layer 2)\",\"contractName\":\"canonical name of this contract (Layer 3 input)\",\"license\":\"    keccak256 of license string (Layer 2)\",\"magic\":\"      steganographic magic baked in deployment bytecode (Layer 3)\",\"repo\":\"       keccak256 of canonical source repository (Layer 2)\",\"version\":\"    human-readable protocol version (Layer 2)\"}}},\"title\":\"HueRotateHook\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"VIMS_AUTHOR()\":{\"notice\":\"keccak256(\\\"vims.protocol.arqonai\\\") \\u2014 canonical author identity.\"},\"VIMS_LICENSE()\":{\"notice\":\"keccak256(\\\"MIT\\\") \\u2014 license under which this code is published.\"},\"VIMS_REPO()\":{\"notice\":\"keccak256(\\\"github.com/arqonai/vimsbot-contracts\\\") \\u2014 canonical source repo.\"},\"VIMS_VERSION()\":{\"notice\":\"Human-readable protocol version.\"},\"getPermissions()\":{\"notice\":\"Subclasses override to declare lifecycle support.\"},\"hookInterfaceId()\":{\"notice\":\"ERC-165 family identifier for hook discovery.         keccak256(\\\"IAgentEvolutionHook(uint256)\\\") truncated to bytes4.\"},\"permissions()\":{\"notice\":\"Bitset of {EvolutionTypes.FLAG_*} declaring which lifecycle hooks         this contract supports. Hosts MUST honor it: callbacks whose flag         is unset MUST NOT be invoked.\"},\"secondsPerStep()\":{\"notice\":\"Seconds elapsed before the hue advances by 1 degree.\"},\"vimsAttest()\":{\"notice\":\"Pure attestation function that defeats dead-code elimination on         the steganographic constants. Anyone (off-chain) can call this         to verify the bytecode they hold matches a canonical VIMS build.\"},\"vimsProvenance()\":{\"notice\":\"Returns the full VIMS provenance block for this contract.\"}},\"notice\":\"Smooth time-based hue rotation. The hue is `(block.timestamp /         secondsPerStep) % 360`. Anyone (typically a Gelato/Chainlink cron)         calls `triggerEvolve(id, TRIGGER_TIME_TICK, \\\"\\\")` and the agent's         color rotates one step per `secondsPerStep` seconds.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/hooks/HueRotateHook.sol\":\"HueRotateHook\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":ds-test/=lib/openzeppelin-contracts/lib/forge-std/lib/ds-test/src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":openzeppelin-contracts-upgradeable/=lib/openzeppelin-cont