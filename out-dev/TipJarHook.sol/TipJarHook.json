\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"agentId\",\"type\":\"uint256\"},{\"internalType\":\"bytes32\",\"name\":\"triggerKind\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"name\":\"onTrigger\",\"outputs\":[{\"components\":[{\"internalType\":\"bool\",\"name\":\"svgChanged\",\"type\":\"bool\"},{\"internalType\":\"string\",\"name\":\"newSvgUri\",\"type\":\"string\"},{\"internalType\":\"bytes\",\"name\":\"newSvgInline\",\"type\":\"bytes\"},{\"internalType\":\"bytes32\",\"name\":\"newStateHash\",\"type\":\"bytes32\"},{\"internalType\":\"bool\",\"name\":\"requiresKeeper\",\"type\":\"bool\"}],\"internalType\":\"struct EvolutionTypes.EvolutionResult\",\"name\":\"r\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"permissions\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"resolver\",\"outputs\":[{\"internalType\":\"contract ITipBeneficiary\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"agentId\",\"type\":\"uint256\"}],\"name\":\"tip\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"tipCount\",\"outputs\":[{\"internalType\":\"uint32\",\"name\":\"\",\"type\":\"uint32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"name\":\"tipped\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vimsAttest\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vimsProvenance\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"author\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"repo\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"license\",\"type\":\"bytes32\"},{\"internalType\":\"string\",\"name\":\"version\",\"type\":\"string\"},{\"internalType\":\"string\",\"name\":\"contractName\",\"type\":\"string\"},{\"internalType\":\"bytes32\",\"name\":\"magic\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"Permission set: FLAG_ON_TRIGGER. Trigger handled: TRIGGER_CUSTOM         (kind == keccak256(\\\"tip.jar\\\")). The `tip(agentId)` function is the         actual payment entry-point; on-chain accounting is updated there         and the SVG state is re-rendered through `onTrigger` either by the         host's permissionless `triggerEvolve` path or directly inline by         the marketplace.\",\"kind\":\"dev\",\"methods\":{\"vimsProvenance()\":{\"returns\":{\"author\":\"     keccak256 of canonical author identity (Layer 2)\",\"contractName\":\"canonical name of this contract (Layer 3 input)\",\"license\":\"    keccak256 of license string (Layer 2)\",\"magic\":\"      steganographic magic baked in deployment bytecode (Layer 3)\",\"repo\":\"       keccak256 of canonical source repository (Layer 2)\",\"version\":\"    human-readable protocol version (Layer 2)\"}}},\"title\":\"TipJarHook\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"VIMS_AUTHOR()\":{\"notice\":\"keccak256(\\\"vims.protocol.arqonai\\\") \\u2014 canonical author identity.\"},\"VIMS_LICENSE()\":{\"notice\":\"keccak256(\\\"MIT\\\") \\u2014 license under which this code is published.\"},\"VIMS_REPO()\":{\"notice\":\"keccak256(\\\"github.com/arqonai/vimsbot-contracts\\\") \\u2014 canonical source repo.\"},\"VIMS_VERSION()\":{\"notice\":\"Human-readable protocol version.\"},\"getPermissions()\":{\"notice\":\"Subclasses override to declare lifecycle support.\"},\"hookInterfaceId()\":{\"notice\":\"ERC-165 family identifier for hook discovery.         keccak256(\\\"IAgentEvolutionHook(uint256)\\\") truncated to bytes4.\"},\"lastTip(uint256)\":{\"notice\":\"Most recent individual tip per agent (in wei) for SVG rendering.\"},\"permissions()\":{\"notice\":\"Bitset of {EvolutionTypes.FLAG_*} declaring which lifecycle hooks         this contract supports. Hosts MUST honor it: callbacks whose flag         is unset MUST NOT be invoked.\"},\"tip(uint256)\":{\"notice\":\"Send ETH as a tip to `agentId`. Forwards to the agent's TBA.\"},\"tipCount(uint256)\":{\"notice\":\"Number of tips received per agent.\"},\"tipped(uint256)\":{\"notice\":\"Cumulative ETH tipped per agent (in wei).\"},\"vimsAttest()\":{\"notice\":\"Pure attestation function that defeats dead-code elimination on         the steganographic constants. Anyone (off-chain) can call this         to verify the bytecode they hold matches a canonical VIMS build.\"},\"vimsProvenance()\":{\"notice\":\"Returns the full VIMS provenance block for this contract.\"}},\"notice\":\"Lets anyone send ETH to a specific agentId; the cumulative tip total         is rendered onto the SVG. Funds are forwarded immediately to a         `beneficiary` resolver (typically the agent's TBA) \\u2014 the hook itself         never holds funds.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/hooks/TipJarHook.sol\":\"TipJarHook\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"none\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts-upgradeable/=lib/openzeppelin-contracts-upgradeable/contracts/\",\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":ds-test/=lib/openzeppelin-contracts/lib/forge-std/lib/ds-test/src/\",\":erc4626-tests/=lib/openzeppelin-contracts/lib/erc4626-tests/\",\":forge-std/=lib/forge-std/src/\",\":halmos-cheatcodes/=lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/\",\":ope